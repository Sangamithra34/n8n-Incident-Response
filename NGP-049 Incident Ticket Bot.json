      "parameters": {
        "jsCode": "const n = $('Get many rows').all().filter(i => i.json.ticket_id).length + 1;\nconst out = $('AI Agent').first().json.output;\nconst desc = $('Edit Fields').first().json.description;\nconst chat = $('Edit Fields').first().json.chat_id;\nconst clean = (s) => String(s == null ? '' : s).replace(/[<>&]/g, ' ');\nlet sev = String(out.severity || '').toLowerCase();\nif (!['red', 'orange', 'green'].includes(sev)) sev = 'orange';\nreturn [{ json: {\n  affected_asset: clean(out.affected_asset),\n  category: clean(out.category),\n  suggested_owner: clean(out.suggested_owner),\n  summary: clean(out.summary),\n  severity: sev,\n  description: desc,\n  chat_id: String(chat),\n  ticket_id: 'NGP-049-' + String(n).padStart(3, '0'),\n  status: 'OPEN',\n  created_at_ts: new Date().toISOString(),\n  model_output: JSON.stringify(out)\n}}];"
      },
